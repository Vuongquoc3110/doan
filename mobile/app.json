{
  "expo": {
    "name": "VQ FRUIT",
    "slug": "klever-fruits-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kleverfruit",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "vn.com.kleverfruits.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép VQ FRUIT quét mã SKU tại quầy.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-font"
    ]
  }
}
